<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:header title="标签 ${it.displayName}" />
  <l:side-panel>
    <l:tasks>
      <j:set var="url" value="${h.getNearestAncestorUrl(request2,it)}"/>
      <l:task contextMenu="false" href="${url}" icon="symbol-tag" title="${%Overview}"/>
      <j:if test="${it.atom}"><l:task href="${url}/configure" icon="symbol-settings" title="${%Configure}" permission="${app.ADMINISTER}" /></j:if>
      <l:task href="${url}/load-statistics" icon="symbol-analytics" title="${%Load Statistics}"/>
      <st:include page="actions.jelly" />
    </l:tasks>
  </l:side-panel>
</j:jelly>
