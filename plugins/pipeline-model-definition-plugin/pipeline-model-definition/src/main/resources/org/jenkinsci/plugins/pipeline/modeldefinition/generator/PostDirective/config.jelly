<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:block>
        有关 <code>post</code> 指令的更多信息，请参阅
        <a href="https://jenkins.io/doc/book/pipeline/syntax/#post" target="_blank">在线文档</a>。
        <f:entry title="条件" help="${descriptor.getHelpPage()}">
            <j:forEach var="c" items="${descriptor.getPossibleConditions()}">
                <div class="jenkins-form-item tr">
                    <f:checkbox title="${c.getValue()}" field="conditions" json="${c.getKey()}" />
                </div>
            </j:forEach>
        </f:entry>
    </f:block>
</j:jelly>
