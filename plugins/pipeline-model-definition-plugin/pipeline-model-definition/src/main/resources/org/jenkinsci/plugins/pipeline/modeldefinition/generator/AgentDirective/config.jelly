<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:l="/lib/layout">
    <f:block>
        有关 <code>agent</code> 指令的更多信息，请参阅
        <a href="https://jenkins.io/doc/book/pipeline/syntax/#agent" target="_blank">在线文档</a>。
    </f:block>
    <f:dropdownList name="agent" title="${descriptor.displayName}" help="${descriptor.getHelpFile('agent')}">
        <j:forEach var="d" items="${descriptor.getDescriptors()}" varStatus="loop">
            <f:dropdownListBlock value="${loop.index}" title="${d.name}: ${d.displayName}"
                                 selected="false" staplerClass="${d.clazz.name}">
                <l:ajax>
                    <j:set var="descriptor" value="${d}" />
                    <j:set var="instance" value="${null}" />
                    <st:include from="${d}" page="${d.configPage}" optional="true" />
                </l:ajax>
            </f:dropdownListBlock>
        </j:forEach>
    </f:dropdownList>
</j:jelly>
