<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:advanced>
        <f:entry field="comparator" title="比较器">
            <f:select />
        </f:entry>
        <f:entry field="id" title="变更 ID">
            <f:textbox/>
        </f:entry>
        <f:entry field="target" title="目标">
            <f:textbox/>
        </f:entry>
        <f:entry field="branch" title="分支">
            <f:textbox/>
        </f:entry>
        <f:entry field="fork" title="Fork 名称">
            <f:textbox/>
        </f:entry>
        <f:entry field="url" title="变更 URL">
            <f:textbox/>
        </f:entry>
        <f:entry field="title" title="标题">
            <f:textbox/>
        </f:entry>
        <f:entry field="author" title="作者">
            <f:textbox/>
        </f:entry>
        <f:entry field="authorDisplayName" title="作者显示名称">
            <f:textbox/>
        </f:entry>
        <f:entry field="authorEmail" title="作者邮箱">
            <f:textbox/>
        </f:entry>
    </f:advanced>
</j:jelly>
