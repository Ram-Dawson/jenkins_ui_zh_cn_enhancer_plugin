<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <j:set var="controls">
    <a href="${rootURL}/manage/role-strategy/" class="jenkins-button jenkins-button--primary">
      ${%Examine}
    </a>
  </j:set>
  <l:adminMonitor controls="${controls}">
    <div>Role Strategy 插件配置中声明的权限存在歧义。请将权限分配更新为用户或组。</div>
    <ul>
      <j:forEach var="entry" items="${it.ambiguousEntries}">
        <li>
          ${entry}
        </li>
      </j:forEach>
    </ul>
  </l:adminMonitor>
</j:jelly>
